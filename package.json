{
  "name": "flipbook-md",
  "version": "0.4.0",
  "description": "Turn Markdown files into browser-based slide presentations and social carousel images. The flipbook CLI, built on @flipbook-md/core.",
  "keywords": [
    "cli",
    "markdown",
    "slides",
    "presentation",
    "slideshow",
    "carousel",
    "nodejs",
    "social-media",
    "instagram-carousel",
    "linkedin-carousel",
    "playwright",
    "png-export",
    "developer-tools"
  ],
  "homepage": "https://github.com/uminocelo/flipbook-md",
  "bugs": {
    "url": "https://github.com/uminocelo/flipbook-md/issues"
  },
  "license": "MIT",
  "author": "Celo (https://github.com/uminocelo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uminocelo/flipbook-md.git"
  },
  "type": "module",
  "bin": {
    "flipbook": "./bin/flipbook.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/flipbook.js show ./examples/database-indexes-project",
    "test": "node --test",
    "export:instagram": "node ./bin/flipbook.js export ./examples/system-design.slide.md --preset instagram"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@flipbook-md/core": "~0.14.0"
  },
  "devDependencies": {
    "yaml": "^2.7.0"
  }
}
